generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Message {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  message     String
  dateAndTime DateTime @default(now())
}

model Appointment {
  id              Int               @id @default(autoincrement())
  name            String
  email           String
  message         String?
  dateAndTime     DateTime          @default(now())
  appointmentSlot String            @unique
}

model BlockedSlot {
	id              Int    @id @default(autoincrement())
	appointmentSlot String @unique
}